},
"typecheck:server": {
  "executor": "@nx/js:tsc",
  "options": {
    "outputPath": "dist/out-tsc/libs/frontend/server",
    "main": "libs/frontend/src/server.ts",
    "tsConfig": "libs/frontend/tsconfig.lib.json",
    "noEmit": true
  }
}

  }
}
