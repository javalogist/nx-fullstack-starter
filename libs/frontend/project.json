{
  "name": "frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/frontend/src",
  "projectType": "library",
  "tags": [],
  "// targets": "to see all targets run: nx show project frontend --web",
  "targets": {
   "typecheck:client": {
