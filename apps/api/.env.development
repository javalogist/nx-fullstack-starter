APP_NAME=Nest APP
GLOBAL_PREFIX=api

# MONGO Configuration
MONGO_URI

#Helment config
HELMET_CSP={"defaultSrc":["'self'"],"scriptSrc":["'self'"],"styleSrc":["'self'"],"imgSrc":["'self'"],"connectSrc":["'self'"],"fontSrc":["'self'"],"objectSrc":["'none'"],"mediaSrc":["'self'"],"frameSrc":["'none'"]}
HELMET_HSTS={"maxAge":63072000,"includeSubDomains":true,"preload":true}
# remaining HELMET_CSP

# CORS config
ALLOWED_ORIGINS=[]
ALLOWED_METHODS=[]
ALLOWED_HEADERS=[]
EXPOSED_HEADERS=[]
ALLOW_CREDENTIALS=true
MAX_AGE=3600

#Compression Config
COMPRESSION_LEVEL=6
COMPRESSION_THRESHOLD=1024
COMPRESSION_WINDOW_BITS=15

#Throttle Config
THROTTLE_TTL=60
THROTTLE_LIMIT=10
THROTTLE_IGNORE_USER_AGENTS=Googlebot,Bingbot


# Pipes Validation Config
VALIDATION_WHITELIST=true
VALIDATION_FORBID_NON_WHITELISTED=true
VALIDATION_TRANSFORM=true

# Swagger Configuration & Api Versioning 
SWAGGER_PATH=api-docs
SWAGGER_JSON_PATH=swagger-json
API_VERSION_STRATEGY=uri
API_VERSION_PREFIX=v
API_DEFAULT_VERSION=1


# JWT Configuration
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=15m
JWT_AUDIENCE=your-audience

# Google OAuth (if using Google strategy)
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback